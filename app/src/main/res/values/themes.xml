<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Operit" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/rainy_primary</item>
        <item name="colorPrimaryVariant">@color/rainy_variant</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/rainy_secondary</item>
        <item name="colorSecondaryVariant">@color/rainy_variant</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/rainy_background</item>
        <!-- Declare support for drawing into the status bar / display cutout area. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Customize your theme here. -->
        
    </style>

    <!-- The launch screen: Orbit's mark on Orbit's background, held until the first page is ready. -->
    <style name="Theme.Operit.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orbit_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/orbit_launch_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Operit</item>
    </style>
</resources>
