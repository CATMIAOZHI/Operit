<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit's ring and moons from orbit_launch_logo, turning while the app loads. An animated vector
     turns on the render thread, so it keeps going while the app's main thread is busy. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <group
                android:name="spin"
                android:pivotX="144"
                android:pivotY="144">
                <path
                    android:pathData="M177.36,121.92 A40,40 0 0,1 137.05,183.39 M110.64,166.08 A40,40 0 0,1 150.95,104.61 M164,116 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 M108,172 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
                    android:strokeColor="#FF6B8E"
                    android:strokeWidth="7.2"
                    android:strokeLineCap="round" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:duration="1100"
                android:repeatCount="infinite"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
