<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:allowBackup="false"
        android:supportsRtl="true">
        <service android:name=".ControlAccessibilityService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
        <service android:name=".ProviderBridgeService" android:exported="true">
            <intent-filter>
                <action android:name="com.ai.assistance.operit.provider.IAccessibilityProvider" />
            </intent-filter>
        </service>
    </application>
</manifest>
