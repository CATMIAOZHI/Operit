# This is a template for your local.properties file.
# To build the project, copy this file to local.properties (which is gitignored)
# and fill in your own values.

# You can create your own GitHub OAuth App here:
# https://github.com/settings/developers

# The callback URL should be operitry://github-oauth-callback
GITHUB_CLIENT_ID="YOUR_OWN_GITHUB_CLIENT_ID_HERE"

# Optional local release signing. Never commit the keystore or these values.
RELEASE_STORE_FILE="/absolute/path/to/operit-ry-release.jks"
RELEASE_STORE_PASSWORD="YOUR_STORE_PASSWORD"
RELEASE_KEY_ALIAS="operit-ry-release"
RELEASE_KEY_PASSWORD="YOUR_KEY_PASSWORD"
